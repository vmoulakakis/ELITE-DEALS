{
  "name": "elite-deals",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "cat source-part-*.b64 | tr -d '\\r\\n' | base64 -d > /tmp/elite-deals-source.tgz && tar -tzf /tmp/elite-deals-source.tgz >/dev/null && tar -xzf /tmp/elite-deals-source.tgz -C . && if [ -f tailwind.config.js ]; then mv tailwind.config.js tailwind.config.cjs; fi",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "lenis": "^1.3.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "wrangler": "^4.0.0"
  }
}
